model Notification {
  id     String @id @default(uuid())
  userId String

  title   String
  message String
  type    NotificationType @default(INFO)
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}