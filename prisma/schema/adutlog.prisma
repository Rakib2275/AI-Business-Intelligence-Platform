model AuditLog {
  id     String @id @default(uuid())
  userId String?

  action      String
  resource    String?
  resourceId  String?
  metadata    Json?

  user User? @relation(fields: [userId],references: [id],onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}