model AIModel {
  id          String  @id @default(uuid())
  provider    String
  name        String
  modelId     String
  inputPrice  Float?
  outputPrice Float?
  isActive    Boolean @default(true)

  agents       AIAgent[]
  usageRecords UsageRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, modelId])
}
