    "import pandas as pd\n",
    "\n",
    "# Original dataset\n",
    "df = pd.read_csv(\"train.csv\")\n",
    "\n",
    "print(\"Original shape:\", df.shape)\n",
    "\n",
    "# Keep 70% rows\n",
    "df_small = df.sample(frac=0.7, random_state=42)\n",
    "\n",
    "# Save smaller dataset\n",
    "df_small.to_csv(\"train_small.csv\", index=False)\n",
    "\n",
    "print(\"New shape:\", df_small.shape)"
   ]
  }
 ],
